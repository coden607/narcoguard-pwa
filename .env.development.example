# Copy this file to .env.local for local development. Never commit .env.local.
NEXT_PUBLIC_APP_NAME=NarcoGuard (Development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ENABLE_LOCATION_TRACKING=true
NEXT_PUBLIC_ENABLE_VITALS_MONITORING=true
NEXT_PUBLIC_ENABLE_EMERGENCY_ALERTS=false
NEXT_PUBLIC_ENABLE_HERO_NETWORK=false
NEXT_PUBLIC_ENABLE_AR_GUIDANCE=true

# Add only the server-side credentials needed for the integration being tested.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
NG_WATCH_API_KEY=
NG_WATCH_ENDPOINT=
