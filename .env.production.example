# Reference for Vercel Production environment variables. Configure values in
# Vercel, never in this file. Safety-critical integrations remain disabled until
# their providers and end-to-end emergency behavior have been explicitly approved.
NEXT_PUBLIC_APP_NAME=NarcoGuard
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ENABLE_LOCATION_TRACKING=true
NEXT_PUBLIC_ENABLE_VITALS_MONITORING=true
NEXT_PUBLIC_ENABLE_EMERGENCY_ALERTS=false
NEXT_PUBLIC_ENABLE_HERO_NETWORK=false
NEXT_PUBLIC_ENABLE_AR_GUIDANCE=true

SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
OPENAI_API_KEY=
NG_WATCH_API_KEY=
NG_WATCH_ENDPOINT=
HERO_NETWORK_API_KEY=
