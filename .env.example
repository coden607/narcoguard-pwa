# Public values (safe to expose in browser bundles)
NEXT_PUBLIC_APP_NAME=NarcoGuard
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ENABLE_LOCATION_TRACKING=true
NEXT_PUBLIC_ENABLE_VITALS_MONITORING=true
NEXT_PUBLIC_ENABLE_EMERGENCY_ALERTS=false
NEXT_PUBLIC_ENABLE_HERO_NETWORK=false
NEXT_PUBLIC_ENABLE_AR_GUIDANCE=true
NEXT_PUBLIC_GOFUNDME_URL=
NEXT_PUBLIC_INVESTOR_CONTACT_URL=mailto:investors@example.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only secrets: configure in Vercel/GitHub; never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional UHS MyChart / Epic SMART-on-FHIR patient connection. Keep blank until the exact
# UHS/Epic app-registration values are approved. NarcoGuard never accepts a MyChart password.
UHS_SMART_CLIENT_ID=
UHS_SMART_AUTH_URL=
UHS_SMART_TOKEN_URL=
UHS_FHIR_BASE_URL=
# 32+ random server-only characters used to encrypt the short-lived FHIR token cookie.
UHS_SMART_SESSION_SECRET=
# "true" shows Continue with Google once the Google provider is on in Supabase and
# <site>/api/auth/callback is in its redirect URLs.
AUTH_GOOGLE_ENABLED=
# Server-only; bypasses RLS. Used only to write watch registrations and hero certificates.
SUPABASE_SERVICE_ROLE_KEY=
# Watch owner lock registry key (server only): a P-256 private JWK as one line of JSON.
# Its public half is built into watch firmware; rotating it requires a firmware update.
WATCH_REGISTRY_PRIVATE_JWK=
# Signs Hero Network test attempts and certificates (server only, 32+ random characters).
HERO_CERT_SECRET=
# Dedicated Hero-only database credential checked inside Postgres RLS. Never expose to the browser.
HERO_DB_API_KEY=
# Optional Web Push for on-call Heroes. The private JWK is server-only; the public key is safe to expose.
# HERO_VAPID_SUBJECT should be a mailto: or https: contact per the Web Push VAPID standard.
HERO_VAPID_PRIVATE_JWK=
HERO_VAPID_PUBLIC_KEY=
HERO_VAPID_SUBJECT=
# Nearby Hero requests stay off until production schema + safety/privacy checks are complete.
HERO_ALERTS_ENABLED=false
DATABASE_URL=
# Vercel/Supabase integrations may provide one of these instead of DATABASE_URL.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
SUPABASE_DB_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Emergency-contact texts (server only). Either TWILIO_PHONE_NUMBER or a messaging service SID,
# plus a Verify service for contact consent. CONTACT_ALERTS_SECRET signs invites and consent
# proofs (32+ random characters; rotating it voids every existing invite and consent).
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
CONTACT_ALERTS_SECRET=
SMS_ALERTS_ENABLED=false
SENDGRID_API_KEY=
# Angel AI provider order outside strict privacy mode:
# OpenRouter -> generic/OpenAI -> Groq -> Kimi -> Vercel AI Gateway.
# Official OpenAI: set OPENAI_API_KEY plus OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FAST_MODEL=
OPENAI_REASONING_MODEL=
# Any OpenAI-compatible service (including compatible Gemini/Grok endpoints):
# set key + base URL + model. BASE_URL should normally end in /v1.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_FAST_MODEL=
OPENAI_COMPAT_REASONING_MODEL=
# Use max_tokens only for providers that reject max_completion_tokens.
OPENAI_COMPAT_TOKEN_PARAM=max_completion_tokens
# Groq remains an optional fallback. It also ranks Brave public search results for resource discovery.
GROQ_API_KEY=
GROQ_MODEL=
# Resource-specific Groq model. Defaults to openai/gpt-oss-20b when blank.
RESOURCE_GROQ_MODEL=
# Server-only Brave Search key. Resource web discovery sends only generic categories + ZIP; never free-text needs or GPS coordinates.
BRAVE_SEARCH_API_KEY=
# Optional task-specific Angel models. Leave blank to use GROQ_MODEL/default for every task.
GROQ_FAST_MODEL=
GROQ_REASONING_MODEL=
# Privacy-first Angel routing. Set strict to allow only routes with an enforceable no-retention/no-data-collection request.
# In strict mode Vercel AI Gateway is preferred with zeroDataRetention=true; OpenRouter is allowed only with data_collection=deny.
# Kimi and direct Groq are skipped in strict mode. ANGEL_GATEWAY_MODEL remains pluggable so a reviewed smarter model can be swapped in without code changes.
ANGEL_PRIVACY_MODE=strict
# Vercel AI Gateway can use deployment OIDC or this optional key.
AI_GATEWAY_API_KEY=
ANGEL_GATEWAY_MODEL=
ANGEL_GATEWAY_FAST_MODEL=
ANGEL_GATEWAY_REASONING_MODEL=
NG_WATCH_API_KEY=
NG_WATCH_ENDPOINT=
HERO_NETWORK_API_KEY=

# Optional automation integrations (server/CI only)
MARKETING_RELAY_URL=
BUFFER_API_KEY=
# Preferred Angel provider when configured. Requests deny provider data collection.
OPENROUTER_API_KEY=
# Optional model overrides (default openai/gpt-oss-120b).
OPENROUTER_MODEL=
OPENROUTER_FAST_MODEL=
OPENROUTER_REASONING_MODEL=
# Legacy fallback: Moonshot/Kimi. KIMI_API_KEY is accepted too.
# NarcoGuard has not confirmed Moonshot's retention/training terms.
MOONSHOT_API_KEY=
KIMI_API_KEY=
# Optional: model overrides (default kimi-k2-turbo-preview) and base URL (default https://api.moonshot.ai/v1).
KIMI_MODEL=
KIMI_FAST_MODEL=
KIMI_REASONING_MODEL=
MOONSHOT_BASE_URL=
CLINE_API_KEY=
HANDOFF_PROVIDER=openrouter
HANDOFF_MODEL=openrouter/free

# Optional project operations integrations (server/CI only)
SLACK_WEBHOOK_URL=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
NOTION_TOKEN=
NOTION_DATABASE_ID=
PROJECT_OPS_CONFIG=

# Non-secret automation controls. Publishing must remain false unless a human
# explicitly approves the external communication.
ALLOW_MARKETING_PUBLISH=false
MARKETING_PUBLISH_NOW=false
MARKETING_IMAGE_URL=
MARKETING_FORCE_DAY=

# Local/CI test tooling. Path to a Chromium binary when the Playwright-bundled
# revision is not installed (the cloud session hook sets it automatically).
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Donations (server only). Use a test key (sk_test_...) until go-live is approved;
# a live key is refused unless DONATIONS_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONATIONS_LIVE=false

# Dark factory harness only (factory/validate.sh sets these; never set them in Vercel).
FACTORY_STUB=
FACTORY_EXTRA_FIXTURES=
FACTORY_SUITE_DIR=
FACTORY_QUIET=
FACTORY_REPORT=
FACTORY_BASE_URL=


# Optional Playwright target. Leave blank to use the local test server configured by playwright.config.ts.
PLAYWRIGHT_BASE_URL=
