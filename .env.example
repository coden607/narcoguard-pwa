# Public values (safe to expose in browser bundles)
NEXT_PUBLIC_APP_NAME=NarcoGuard
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ENABLE_LOCATION_TRACKING=true
NEXT_PUBLIC_ENABLE_VITALS_MONITORING=true
NEXT_PUBLIC_ENABLE_EMERGENCY_ALERTS=false
NEXT_PUBLIC_ENABLE_HERO_NETWORK=false
NEXT_PUBLIC_ENABLE_AR_GUIDANCE=true
NEXT_PUBLIC_GOFUNDME_URL=
NEXT_PUBLIC_INVESTOR_CONTACT_URL=mailto:investors@example.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only secrets: configure in Vercel/GitHub; never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
# Vercel/Supabase integrations may provide one of these instead of DATABASE_URL.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
SUPABASE_DB_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
OPENAI_API_KEY=
NG_WATCH_API_KEY=
NG_WATCH_ENDPOINT=
HERO_NETWORK_API_KEY=
