{
  "name": "narcoguard-pwa",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Public PWA demo and early wearable concept for overdose-prevention research and community response",
  "license": "MIT",
  "author": "Stephen Blanford <narcoguard607@gmail.com>",
  "scripts": {
    "build": "node scripts/run-next-build.js",
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:chromium": "npm run build && playwright test --project=chromium --project='Mobile Chrome'",
    "test:e2e:ui": "playwright test --ui-host=127.0.0.1 --ui-port=9323",
    "test:pwa": "node scripts/run-pwa-tests.js",
    "verify": "npm run lint && npm run typecheck && npm run validate:production && npm run validate:supabase && npm run validate:claims && npm run test:signals && npm run validate:watch-design && npm audit --audit-level=high && npm run build && npm run test:pwa",
    "health": "npm run verify",
    "marketing:run": "node scripts/post-daily-campaign.js",
    "marketing:buffer": "node scripts/push-buffer-campaign.js",
    "marketing:videos": "bash scripts/generate-tiktok-videos.sh",
    "start": "next start",
    "validate:supabase": "node scripts/validate-supabase.js",
    "validate:claims": "node scripts/validate-claims.js",
    "test:signals": "tsx scripts/test-signal-fusion.ts",
    "validate:watch-design": "tsx scripts/validate-watch-design.ts",
    "validate:production": "node scripts/validate-production.js"
  },
