# Reference for Vercel Preview environment variables. Configure these in the
# Vercel dashboard; do not create or commit a populated .env.preview file.
NEXT_PUBLIC_APP_NAME=NarcoGuard (Preview)
NEXT_PUBLIC_APP_URL=https://preview-domain.example
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ENABLE_LOCATION_TRACKING=true
NEXT_PUBLIC_ENABLE_VITALS_MONITORING=true
NEXT_PUBLIC_ENABLE_EMERGENCY_ALERTS=false
NEXT_PUBLIC_ENABLE_HERO_NETWORK=false
NEXT_PUBLIC_ENABLE_AR_GUIDANCE=true

# Use preview/test resources and least-privilege credentials, never production values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
NG_WATCH_API_KEY=
NG_WATCH_ENDPOINT=
